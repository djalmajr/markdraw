{
  "name": "@markdraw/desktop",
  "version": "0.26.1-9",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "macos:dev-signing": "bash scripts/macos-dev-signing-setup.sh",
    "dev:frontend": "bun run --filter @markdraw/i18n compile && bun run prepare:excalidraw && vite",
    "build": "tauri build",
    "build:frontend": "bun run --filter @markdraw/i18n compile && bun run prepare:excalidraw --force && vite build",
    "prepare:excalidraw": "node scripts/prepare-excalidraw-guest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test e2e/specs",
    "test:e2e": "bun test e2e/specs",
    "test:memlab": "bunx memlab run --scenario e2e/memory/scenario.cjs"
  },
  "dependencies": {
    "@markdraw/ai": "workspace:*",
    "@markdraw/core": "workspace:*",
    "@markdraw/diagram": "workspace:*",
    "@markdraw/i18n": "workspace:*",
    "@markdraw/ui": "workspace:*",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@zomme/frame": "^1.3.0",
    "pdfjs-dist": "^6.5.438",
    "solid-js": "2.0.1",
    "@solidjs/web": "2.0.1"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.558",
    "@tauri-apps/cli": "^2.12.6",
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "memlab": "^2.0.6",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.8",
    "@solidjs/vite-plugin": "3.0.1"
  }
}
