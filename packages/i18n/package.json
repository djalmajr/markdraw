{
  "name": "@markdraw/i18n",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/paraglide/messages.js",
    "./solid": "./src/solid.ts",
    "./runtime": "./src/paraglide/runtime.js"
  },
  "scripts": {
    "compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable preferredLanguage baseLocale --emit-ts-declarations",
    "prepare": "bun run compile",
    "typecheck": "bun run compile && tsc --noEmit"
  },
  "peerDependencies": {
    "solid-js": "2.0.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "solid-js": "2.0.1",
    "typescript": "^5.9.3"
  }
}
