{
  "name": "@markdraw/ui",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "test": "bun test && vitest run --config vitest.config.ts",
    "test:bun": "bun test",
    "test:vitest": "vitest run --config vitest.config.ts",
    "test:vitest:watch": "vitest --config vitest.config.ts",
    "test:coverage": "bun test --coverage && vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@markdraw/ai": "workspace:*",
    "@markdraw/core": "workspace:*",
    "@markdraw/i18n": "workspace:*",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/abstract": "0.4.0",
    "@dnd-kit/dom": "0.4.0",
    "@dnd-kit/state": "0.4.0",
    "@mdit/plugin-alert": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "pdfjs-dist": "^6.5.438",
    "prismjs": "^1.30.0",
    "solid-js": "2.0.1",
    "tw-animate-css": "^1.4.0",
    "@solidjs/web": "2.0.1",
    "@ui-sdk/core": "0.1.0-beta.10",
    "@ui-sdk/solid": "0.1.0-beta.10"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.558",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.10.3",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "@solidjs/vite-plugin": "3.0.1"
  }
