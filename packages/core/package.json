{
  "name": "@markdraw/core",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:bench": "bun run src/__bench__/conversion.bench.ts",
    "test:mutation": "stryker run",
    "type-coverage": "bunx type-coverage --strict --at-least 95 --ignore-files \"**/*.test.ts\" --ignore-files \"**/__bench__/**\" --ignore-files \"**/fuzz/**\" --ignore-files \"**/__properties__/**\" --ignore-files \"**/__diff__/**\" --ignore-files \"**/__golden__/**\" --ignore-files \"**/__metamorphic__/**\" --ignore-files \"**/__conformance__/**\"",
    "fuzz:frontmatter": "jazzer fuzz/frontmatter.fuzz.mjs -- -timeout=30",
    "fuzz:scan-includes": "jazzer fuzz/scan-includes.fuzz.mjs -- -timeout=30",
    "fuzz:xrefs": "jazzer fuzz/xrefs.fuzz.mjs -- -timeout=30",
    "fuzz:schemas": "jazzer fuzz/schemas.fuzz.mjs -- -timeout=30",
    "fuzz:ci": "bun run fuzz:frontmatter && bun run fuzz:scan-includes && bun run fuzz:xrefs && bun run fuzz:schemas"
  },
  "dependencies": {
    "@asciidoctor/core": "^4.3.0",
    "@mdit/plugin-alert": "^2.2.0",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "fzf": "^0.5.2",
    "js-yaml": "^5.5.0",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "@stryker-mutator/core": "^10.1.1",
    "fast-check": "^4.10.3",
    "marked": "^18.2.1",
    "type-coverage": "^2.31.2",
    "typescript": "^6.0.3"
  }
}
